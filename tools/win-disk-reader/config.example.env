# Copy this file to config.env (same directory) and edit for your setup.
# config.env is gitignored — it's specific to your machine and paths, and should never be
# committed.
# ============================================================

# Folder that contains your VM's qcow2 disk file — the .utm bundle's Data folder.
# Example if the .utm bundle is still in UTM's default sandboxed location:
#   QCOW2_HOST_DIR="$HOME/Library/Containers/com.utmapp.UTM/Data/Documents/YourVM.utm/Data"
# Example if you moved the bundle elsewhere (see ../../docs/06-promote-to-utm.md):
#   QCOW2_HOST_DIR="$HOME/virtual-machines/YourVM.utm/Data"
QCOW2_HOST_DIR="$HOME/virtual-machines/YourVM.utm/Data"
QCOW2_FILENAME="windows.qcow2"

# String used with pgrep to detect whether the VM is currently running, matched against the
# qemu-system-x86_64 process command line. The VM's own UUID is the most reliable value — find it
# with:
#   plutil -p "/path/to/YourVM.utm/config.plist" | grep -i uuid
VM_RUNNING_MATCH="REPLACE-WITH-YOUR-VM-UUID"

# Docker / OrbStack
DOCKER_CONTEXT="orbstack"
BASE_IMAGE="debian:bookworm-slim"
IMAGE_NAME="win-disk-reader:latest"
CONTAINER_NAME="win-disk-reader"

# SMB — published on 127.0.0.1 only, never reachable from the network
SMB_BIND_ADDR="127.0.0.1"
SMB_HOST_PORT="14459"
SMB_SHARE_NAME="winc"

# Mount path inside the container itself
CONTAINER_MOUNT_POINT="/mnt/winc"
NBD_DEVICE="/dev/nbd0"

# Hostname assigned to the container (set via `docker run --hostname`) and also passed in as an
# env var of the same name, so mount-disk.sh/unmount-disk.sh can confirm both that they're running
# inside a container AND that it's specifically this one, before touching any disk device.
CONTAINER_HOSTNAME="win-disk-reader.internal"
